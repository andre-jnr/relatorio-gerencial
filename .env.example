# Copie para .env e preencha. O .env nunca vai para o git nem para o navegador.

# Porta do sistema (tabela de orientacoes-projetos-ia.md)
PORT=3007

# Lojas que o painel mostra e consulta, separadas por vírgula (slugs de config/unidades.json).
# Loja fora desta lista não aparece no painel e o banco dela nunca é consultado.
# Disponíveis: parque_dez, parque_dez_flores, ponta_negra, morada_do_sol, monte_das_oliveiras, cd
LOJAS=parque_dez,parque_dez_flores

# Login do SQL Server (o mesmo para todas as lojas)
DB_USUARIO=
DB_SENHA=

# Login próprio do servidor da Flores (usado em "Parque Dez + Flores")
FLORES_DB_USUARIO=
FLORES_DB_SENHA=

# Por quanto tempo reaproveitar a última consulta (minutos) e quantos meses de histórico buscar
CACHE_MINUTOS=15
MESES_HISTORICO=24
